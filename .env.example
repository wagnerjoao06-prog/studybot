# .env.example - variáveis necessárias para executar o studybot
# Preencha com valores reais em um arquivo .env (NÃO comitar tokens reais)

# Tokens e IDs do Discord
BOT_TOKEN=your_production_bot_token_here
DEV_BOT_TOKEN=your_dev_bot_token_here
APP_ID=your_production_app_id_here
DEV_APP_ID=your_dev_app_id_here
PUBLIC_KEY=your_public_key_here
DEV_PUBLIC_KEY=your_dev_public_key_here
DEV_GUILD=your_dev_guild_id_here

# MongoDB
MONGODB_URI=mongodb://user:pass@host:27017/production_db
DEV_MONGODB_URI=mongodb://localhost:27027/devdb

# Porta do serviço (opcional)
PORT=3000
